# ---------------------------------------------------------------
# Datasets and dataset-derived caches (never commit)
# ---------------------------------------------------------------
/data/
/datasets/
*.npy
*.npz
*.mat
*.tif
*.tiff
*.hdr
*.envi
cache_leaf_*

# ---------------------------------------------------------------
# Trained artefacts
# ---------------------------------------------------------------
*.pkl
*.pt
*.pth
*.ckpt

# ---------------------------------------------------------------
# Bulk run trees of the private workspace (root-anchored)
# ---------------------------------------------------------------
/runs/
/runs_v2/
/runs_v3/
/artifacts/predictions/*
!/artifacts/predictions/.gitkeep
/artifacts/aggregates/*
!/artifacts/aggregates/.gitkeep
/artifacts/transforms/*
!/artifacts/transforms/.gitkeep
/artifacts/publication/*
!/artifacts/publication/.gitkeep
/.tmp/

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

